# Async SQLAlchemy URL of the application database (required).
DATABASE_URL=postgresql+asyncpg://toth:toth@localhost:5432/toth
# Async SQLAlchemy URL of the separate database the API test suite uses; must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql+asyncpg://toth:toth@localhost:5432/toth_test
# OpenRouter API key for LLM calls (required by the agent features, not by the foundation).
OPENROUTER_API_KEY=replace-me
# Key that authorises admin-only API calls such as creating invitations.
ADMIN_API_KEY=replace-me
# Secret used to sign session cookies.
SESSION_SECRET=replace-me
# Python logging level for the API (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
